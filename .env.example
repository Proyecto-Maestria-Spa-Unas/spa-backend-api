# Copie este archivo a .env para desarrollo local (cp .env.example .env).
# .env está en .gitignore: NUNCA lo suba. Los valores reales de staging y producción
# viven en Vercel (Settings → Environment Variables), no aquí.

APP_ENV=development

# Base local de docker compose (puerto 54322 para no chocar con un PostgreSQL instalado).
DB_URL=postgresql+psycopg://postgres:postgres@localhost:54322/postgres

# Cualquier texto largo en local. El de staging lo custodia plataforma.
JWT_SECRET=cambie-este-valor-en-local-por-uno-largo
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=30

CORS_ORIGINS=["http://localhost:5173"]

# Solo S1 · Identidad, cuando implemente el adaptador de Supabase Auth.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Carpeta de spa-database si no está en ../spa-database
# SPA_DATABASE_DIR=../spa-database
